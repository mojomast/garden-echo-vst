{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GardenPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "producer",
    "evidenceMode",
    "mothbakeCommit",
    "assets",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "evidenceMode": {
      "enum": [
        "synthetic",
        "atlas-recorded",
        "atlas-live"
      ]
    },
    "mothbakeCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "path",
          "mime",
          "sha256",
          "sourceRunIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "mime": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceRunIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engineId",
          "execution",
          "parameters",
          "inputSha256",
          "outputSha256",
          "jobId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "engineId": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "simulator",
              "hardware",
              "unknown"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "inputSha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "outputSha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "jobId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
